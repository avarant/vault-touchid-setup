<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hashicorp.vault</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/vault</string>
        <string>server</string>
        <string>-config</string>
        <string>/Users/YOUR_USERNAME/vault/vault.hcl</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USERNAME/vault</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/vault/vault.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/vault/vault.log</string>
</dict>
</plist>
